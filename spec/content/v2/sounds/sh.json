 "hero": {
  "name": "Șușu",
  "who": "trenulețul",
  "emoji": "🚂",
  "says": "șșșș",
  "saysVoice": "human-needed",
  "line": "Trenulețul Șușu pleacă la drum: șșșș! Suflă și tu, ca trenul.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.sh.listen",
    "text": "Ascultă bine! Trenulețul Șușu încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.sh.listen"
   },
   "warmup": {
    "key": "open.sh.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Șușu.",
    "voice": "open.sh.warmup"
   },
   "isolated": {
    "key": "open.sh.isolated",
    "text": "Șușu suflă lung, ca trenul. Suflă și tu, cât poți!",
    "voice": "open.sh.isolated"
   },
   "syllables": {
    "key": "open.sh.syllables",
    "text": "Șușu pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.sh.syllables"
   },
   "back": {
    "key": "open.sh.back",
    "text": "Acum sunetul vine la urmă. Șușu te așteaptă la capăt.",
    "voice": "open.sh.back"
   },
   "wordsInitial": {
    "key": "open.sh.wordsInitial",
    "text": "Șușu a pierdut cuvintele care încep cu Ș. Le căutăm?",
    "voice": "open.sh.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.sh.wordsMedial",
    "text": "Unele cuvinte ascund Ș la mijloc. Le găsim împreună?",
    "voice": "open.sh.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.sh.wordsFinal",
    "text": "Acum Ș stă la final. Ține-l până la capăt!",
    "voice": "open.sh.wordsFinal"
   },
   "clusters": {
    "key": "open.sh.clusters",
    "text": "Ș are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.sh.clusters"
   },
   "pairs": {
    "key": "open.sh.pairs",
    "text": "Două cuvinte seamănă mult. Șușu le încurcă. Ajuți?",
    "voice": "open.sh.pairs"
   },
   "sentences": {
    "key": "open.sh.sentences",
    "text": "Șușu spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.sh.sentences"
   },
   "twister": {
    "key": "open.sh.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.sh.twister"
   },
   "retell": {
    "key": "open.sh.retell",
    "text": "Uite trei poze cu Șușu. Ce s-a întâmplat?",
    "voice": "open.sh.retell"
   },
   "everyday": {
    "key": "open.sh.everyday",
    "text": "Azi Ș vine cu tine acasă. Ai o misiune!",
    "voice": "open.sh.everyday"
   }
  }
 },
