 "hero": {
  "name": "Gigel",
  "who": "motorașul",
  "emoji": "🛵",
  "says": "gi-gi-gi",
  "saysVoice": "human-needed",
  "line": "Motorașul Gigel pornește: gi-gi-gi! Palma pe gât și pornește-l și tu.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.ge.listen",
    "text": "Ascultă bine! Motorașul Gigel încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.ge.listen"
   },
   "warmup": {
    "key": "open.ge.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Gigel.",
    "voice": "open.ge.warmup"
   },
   "isolated": {
    "key": "open.ge.isolated",
    "text": "Gigel pornește scurt, de trei ori. Pornește-l și tu!",
    "voice": "open.ge.isolated"
   },
   "syllables": {
    "key": "open.ge.syllables",
    "text": "Gigel pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.ge.syllables"
   },
   "back": {
    "key": "open.ge.back",
    "text": "Acum sunetul vine la urmă. Gigel te așteaptă la capăt.",
    "voice": "open.ge.back"
   },
   "wordsInitial": {
    "key": "open.ge.wordsInitial",
    "text": "Gigel a pierdut cuvintele care încep cu GE. Le căutăm?",
    "voice": "open.ge.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.ge.wordsMedial",
    "text": "Unele cuvinte ascund GE la mijloc. Le găsim împreună?",
    "voice": "open.ge.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.ge.wordsFinal",
    "text": "Acum GE stă la final. Ține-l până la capăt!",
    "voice": "open.ge.wordsFinal"
   },
   "clusters": {
    "key": "open.ge.clusters",
    "text": "GE are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.ge.clusters"
   },
   "pairs": {
    "key": "open.ge.pairs",
    "text": "Două cuvinte seamănă mult. Gigel le încurcă. Ajuți?",
    "voice": "open.ge.pairs"
   },
   "sentences": {
    "key": "open.ge.sentences",
    "text": "Gigel spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.ge.sentences"
   },
   "twister": {
    "key": "open.ge.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.ge.twister"
   },
   "retell": {
    "key": "open.ge.retell",
    "text": "Uite trei poze cu Gigel. Ce s-a întâmplat?",
    "voice": "open.ge.retell"
   },
   "everyday": {
    "key": "open.ge.everyday",
    "text": "Azi GE vine cu tine acasă. Ai o misiune!",
    "voice": "open.ge.everyday"
   }
  }
 },
