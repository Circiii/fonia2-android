 "hero": {
  "name": "Lalalu",
  "who": "leul",
  "emoji": "🦁",
  "says": "lll",
  "saysVoice": "human-needed",
  "line": "Leul Lalalu cântă cu limba sus: la-la-la! Cântă și tu cu el.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.l.listen",
    "text": "Ascultă bine! Leul Lalalu încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.l.listen"
   },
   "warmup": {
    "key": "open.l.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Lalalu.",
    "voice": "open.l.warmup"
   },
   "isolated": {
    "key": "open.l.isolated",
    "text": "Lalalu cântă cu limba sus. Cântă și tu, lung!",
    "voice": "open.l.isolated"
   },
   "syllables": {
    "key": "open.l.syllables",
    "text": "Lalalu pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.l.syllables"
   },
   "back": {
    "key": "open.l.back",
    "text": "Acum sunetul vine la urmă. Lalalu te așteaptă la capăt.",
    "voice": "open.l.back"
   },
   "wordsInitial": {
    "key": "open.l.wordsInitial",
    "text": "Lalalu a pierdut cuvintele care încep cu L. Le căutăm?",
    "voice": "open.l.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.l.wordsMedial",
    "text": "Unele cuvinte ascund L la mijloc. Le găsim împreună?",
    "voice": "open.l.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.l.wordsFinal",
    "text": "Acum L stă la final. Ține-l până la capăt!",
    "voice": "open.l.wordsFinal"
   },
   "clusters": {
    "key": "open.l.clusters",
    "text": "L are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.l.clusters"
   },
   "pairs": {
    "key": "open.l.pairs",
    "text": "Două cuvinte seamănă mult. Lalalu le încurcă. Ajuți?",
    "voice": "open.l.pairs"
   },
   "sentences": {
    "key": "open.l.sentences",
    "text": "Lalalu spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.l.sentences"
   },
   "twister": {
    "key": "open.l.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.l.twister"
   },
   "retell": {
    "key": "open.l.retell",
    "text": "Uite trei poze cu Lalalu. Ce s-a întâmplat?",
    "voice": "open.l.retell"
   },
   "everyday": {
    "key": "open.l.everyday",
    "text": "Azi L vine cu tine acasă. Ai o misiune!",
    "voice": "open.l.everyday"
   }
  }
 },
 "voiced": true,
 "holdMode": "sustain",
 "typicalByAge": 5,
