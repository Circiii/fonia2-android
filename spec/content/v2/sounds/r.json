 "hero": {
  "name": "Rică",
  "who": "tigrul",
  "emoji": "🐯",
  "says": "rrr",
  "saysVoice": "human-needed",
  "line": "Tigrul Rică mârâie când se joacă: rrr! Mârâie și tu, ca un tigru.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.r.listen",
    "text": "Ascultă bine! Tigrul Rică încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.r.listen"
   },
   "warmup": {
    "key": "open.r.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Rică.",
    "voice": "open.r.warmup"
   },
   "isolated": {
    "key": "open.r.isolated",
    "text": "Rică mârâie când se joacă. Mârâie și tu, ca el!",
    "voice": "open.r.isolated"
   },
   "syllables": {
    "key": "open.r.syllables",
    "text": "Rică pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.r.syllables"
   },
   "back": {
    "key": "open.r.back",
    "text": "Acum sunetul vine la urmă. Rică te așteaptă la capăt.",
    "voice": "open.r.back"
   },
   "wordsInitial": {
    "key": "open.r.wordsInitial",
    "text": "Rică a pierdut cuvintele care încep cu R. Le căutăm?",
    "voice": "open.r.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.r.wordsMedial",
    "text": "Unele cuvinte ascund R la mijloc. Le găsim împreună?",
    "voice": "open.r.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.r.wordsFinal",
    "text": "Acum R stă la final. Ține-l până la capăt!",
    "voice": "open.r.wordsFinal"
   },
   "clusters": {
    "key": "open.r.clusters",
    "text": "R are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.r.clusters"
   },
   "pairs": {
    "key": "open.r.pairs",
    "text": "Două cuvinte seamănă mult. Rică le încurcă. Ajuți?",
    "voice": "open.r.pairs"
   },
   "sentences": {
    "key": "open.r.sentences",
    "text": "Rică spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.r.sentences"
   },
   "twister": {
    "key": "open.r.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.r.twister"
   },
   "retell": {
    "key": "open.r.retell",
    "text": "Uite trei poze cu Rică. Ce s-a întâmplat?",
    "voice": "open.r.retell"
   },
   "everyday": {
    "key": "open.r.everyday",
    "text": "Azi R vine cu tine acasă. Ai o misiune!",
    "voice": "open.r.everyday"
   }
  }
 },
