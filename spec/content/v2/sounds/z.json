 "hero": {
  "name": "Zuzu",
  "who": "albinuța",
  "emoji": "🐝",
  "says": "zzzz",
  "saysVoice": "human-needed",
  "line": "Albinuța Zuzu zboară din floare în floare: zzzz! Palma pe gât și bâzâie cu ea.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.z.listen",
    "text": "Ascultă bine! Albinuța Zuzu încurcă uneori cuvintele. O prinzi?",
    "voice": "open.z.listen"
   },
   "warmup": {
    "key": "open.z.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Zuzu.",
    "voice": "open.z.warmup"
   },
   "isolated": {
    "key": "open.z.isolated",
    "text": "Zuzu bâzâie lung. Bâzâie și tu, cât poți!",
    "voice": "open.z.isolated"
   },
   "syllables": {
    "key": "open.z.syllables",
    "text": "Zuzu pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.z.syllables"
   },
   "back": {
    "key": "open.z.back",
    "text": "Acum sunetul vine la urmă. Zuzu te așteaptă la capăt.",
    "voice": "open.z.back"
   },
   "wordsInitial": {
    "key": "open.z.wordsInitial",
    "text": "Zuzu a pierdut cuvintele care încep cu Z. Le căutăm?",
    "voice": "open.z.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.z.wordsMedial",
    "text": "Unele cuvinte ascund Z la mijloc. Le găsim împreună?",
    "voice": "open.z.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.z.wordsFinal",
    "text": "Acum Z stă la final. Ține-l până la capăt!",
    "voice": "open.z.wordsFinal"
   },
   "clusters": {
    "key": "open.z.clusters",
    "text": "Z are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.z.clusters"
   },
   "pairs": {
    "key": "open.z.pairs",
    "text": "Două cuvinte seamănă mult. Zuzu le încurcă. Ajuți?",
    "voice": "open.z.pairs"
   },
   "sentences": {
    "key": "open.z.sentences",
    "text": "Zuzu spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.z.sentences"
   },
   "twister": {
    "key": "open.z.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.z.twister"
   },
   "retell": {
    "key": "open.z.retell",
    "text": "Uite trei poze cu Zuzu. Ce s-a întâmplat?",
    "voice": "open.z.retell"
   },
   "everyday": {
    "key": "open.z.everyday",
    "text": "Azi Z vine cu tine acasă. Ai o misiune!",
    "voice": "open.z.everyday"
   }
  }
 },
