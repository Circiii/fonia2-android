 "hero": {
  "name": "Sâsâilă",
  "who": "șarpele",
  "emoji": "🐍",
  "says": "sssss",
  "saysVoice": "human-needed",
  "line": "Sâsâilă alunecă prin iarbă: sssss. Sâsâie și tu cu el!",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.s.listen",
    "text": "Ascultă bine! Sâsâilă încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.s.listen"
   },
   "warmup": {
    "key": "open.s.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Sâsâilă.",
    "voice": "open.s.warmup"
   },
   "isolated": {
    "key": "open.s.isolated",
    "text": "Sâsâilă sâsâie lung. Sâsâie și tu, cât poți!",
    "voice": "open.s.isolated"
   },
   "syllables": {
    "key": "open.s.syllables",
    "text": "Sâsâilă pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.s.syllables"
   },
   "back": {
    "key": "open.s.back",
    "text": "Acum sunetul vine la urmă. Sâsâilă te așteaptă la capăt.",
    "voice": "open.s.back"
   },
   "wordsInitial": {
    "key": "open.s.wordsInitial",
    "text": "Sâsâilă a pierdut cuvintele care încep cu S. Le căutăm?",
    "voice": "open.s.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.s.wordsMedial",
    "text": "Unele cuvinte ascund S la mijloc. Le găsim împreună?",
    "voice": "open.s.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.s.wordsFinal",
    "text": "Acum S stă la final. Ține-l până la capăt!",
    "voice": "open.s.wordsFinal"
   },
   "clusters": {
    "key": "open.s.clusters",
    "text": "S are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.s.clusters"
   },
   "pairs": {
    "key": "open.s.pairs",
    "text": "Două cuvinte seamănă mult. Sâsâilă le încurcă. Ajuți?",
    "voice": "open.s.pairs"
   },
   "sentences": {
    "key": "open.s.sentences",
    "text": "Sâsâilă spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.s.sentences"
   },
   "twister": {
    "key": "open.s.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.s.twister"
   },
   "retell": {
    "key": "open.s.retell",
    "text": "Uite trei poze cu Sâsâilă. Ce s-a întâmplat?",
    "voice": "open.s.retell"
   },
   "everyday": {
    "key": "open.s.everyday",
    "text": "Azi S vine cu tine acasă. Ai o misiune!",
    "voice": "open.s.everyday"
   }
  }
 },
