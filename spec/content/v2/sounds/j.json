 "hero": {
  "name": "Vâjâilă",
  "who": "vântul",
  "emoji": "🌬️",
  "says": "jjjj",
  "saysVoice": "human-needed",
  "line": "Vântul Vâjâilă suflă printre frunze: jjjj! Palma pe gât și suflă cu el.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.j.listen",
    "text": "Ascultă bine! Vântul Vâjâilă încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.j.listen"
   },
   "warmup": {
    "key": "open.j.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Vâjâilă.",
    "voice": "open.j.warmup"
   },
   "isolated": {
    "key": "open.j.isolated",
    "text": "Vâjâilă vâjâie lung. Vâjâie și tu, cât poți!",
    "voice": "open.j.isolated"
   },
   "syllables": {
    "key": "open.j.syllables",
    "text": "Vâjâilă pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.j.syllables"
   },
   "back": {
    "key": "open.j.back",
    "text": "Acum sunetul vine la urmă. Vâjâilă te așteaptă la capăt.",
    "voice": "open.j.back"
   },
   "wordsInitial": {
    "key": "open.j.wordsInitial",
    "text": "Vâjâilă a pierdut cuvintele care încep cu J. Le căutăm?",
    "voice": "open.j.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.j.wordsMedial",
    "text": "Unele cuvinte ascund J la mijloc. Le găsim împreună?",
    "voice": "open.j.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.j.wordsFinal",
    "text": "Acum J stă la final. Ține-l până la capăt!",
    "voice": "open.j.wordsFinal"
   },
   "clusters": {
    "key": "open.j.clusters",
    "text": "J are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.j.clusters"
   },
   "pairs": {
    "key": "open.j.pairs",
    "text": "Două cuvinte seamănă mult. Vâjâilă le încurcă. Ajuți?",
    "voice": "open.j.pairs"
   },
   "sentences": {
    "key": "open.j.sentences",
    "text": "Vâjâilă spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.j.sentences"
   },
   "twister": {
    "key": "open.j.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.j.twister"
   },
   "retell": {
    "key": "open.j.retell",
    "text": "Uite trei poze cu Vâjâilă. Ce s-a întâmplat?",
    "voice": "open.j.retell"
   },
   "everyday": {
    "key": "open.j.everyday",
    "text": "Azi J vine cu tine acasă. Ai o misiune!",
    "voice": "open.j.everyday"
   }
  }
 },
