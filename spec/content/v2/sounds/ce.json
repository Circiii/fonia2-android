 "hero": {
  "name": "Cici",
  "who": "stropitoarea",
  "emoji": "💧",
  "says": "ci-ci-ci",
  "saysVoice": "human-needed",
  "line": "Stropitoarea Cici udă florile: ci-ci-ci! Stropește și tu, scurt, ca ea.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.ce.listen",
    "text": "Ascultă bine! Stropitoarea Cici încurcă uneori cuvintele. O prinzi?",
    "voice": "open.ce.listen"
   },
   "warmup": {
    "key": "open.ce.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Cici.",
    "voice": "open.ce.warmup"
   },
   "isolated": {
    "key": "open.ce.isolated",
    "text": "Cici stropește florile, scurt și repede. Stropește și tu!",
    "voice": "open.ce.isolated"
   },
   "syllables": {
    "key": "open.ce.syllables",
    "text": "Cici pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.ce.syllables"
   },
   "back": {
    "key": "open.ce.back",
    "text": "Acum sunetul vine la urmă. Cici te așteaptă la capăt.",
    "voice": "open.ce.back"
   },
   "wordsInitial": {
    "key": "open.ce.wordsInitial",
    "text": "Cici a pierdut cuvintele care încep cu CE. Le căutăm?",
    "voice": "open.ce.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.ce.wordsMedial",
    "text": "Unele cuvinte ascund CE la mijloc. Le găsim împreună?",
    "voice": "open.ce.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.ce.wordsFinal",
    "text": "Acum CE stă la final. Ține-l până la capăt!",
    "voice": "open.ce.wordsFinal"
   },
   "clusters": {
    "key": "open.ce.clusters",
    "text": "CE are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.ce.clusters"
   },
   "pairs": {
    "key": "open.ce.pairs",
    "text": "Două cuvinte seamănă mult. Cici le încurcă. Ajuți?",
    "voice": "open.ce.pairs"
   },
   "sentences": {
    "key": "open.ce.sentences",
    "text": "Cici spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.ce.sentences"
   },
   "twister": {
    "key": "open.ce.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.ce.twister"
   },
   "retell": {
    "key": "open.ce.retell",
    "text": "Uite trei poze cu Cici. Ce s-a întâmplat?",
    "voice": "open.ce.retell"
   },
   "everyday": {
    "key": "open.ce.everyday",
    "text": "Azi CE vine cu tine acasă. Ai o misiune!",
    "voice": "open.ce.everyday"
   }
  }
 },
