 "hero": {
  "name": "Țuțu",
  "who": "șoricelul",
  "emoji": "🐭",
  "says": "ț-ț-ț",
  "saysVoice": "human-needed",
  "line": "Șoricelul Țuțu e mic și iute: ț-ț-ț! Fă și tu ca el, scurt și repede.",
  "lineVoice": "human-needed",
  "chapters": {
   "listen": {
    "key": "open.ts.listen",
    "text": "Ascultă bine! Șoricelul Țuțu încurcă uneori cuvintele. Îl prinzi?",
    "voice": "open.ts.listen"
   },
   "warmup": {
    "key": "open.ts.warmup",
    "text": "Înainte de joacă, trezim gura împreună cu Țuțu.",
    "voice": "open.ts.warmup"
   },
   "isolated": {
    "key": "open.ts.isolated",
    "text": "Țuțu face pași mici, scurt și repede. Fă și tu!",
    "voice": "open.ts.isolated"
   },
   "syllables": {
    "key": "open.ts.syllables",
    "text": "Țuțu pune sunetul lângă vocale. Urcă în trenul de silabe!",
    "voice": "open.ts.syllables"
   },
   "back": {
    "key": "open.ts.back",
    "text": "Acum sunetul vine la urmă. Țuțu te așteaptă la capăt.",
    "voice": "open.ts.back"
   },
   "wordsInitial": {
    "key": "open.ts.wordsInitial",
    "text": "Țuțu a pierdut cuvintele care încep cu Ț. Le căutăm?",
    "voice": "open.ts.wordsInitial"
   },
   "wordsMedial": {
    "key": "open.ts.wordsMedial",
    "text": "Unele cuvinte ascund Ț la mijloc. Le găsim împreună?",
    "voice": "open.ts.wordsMedial"
   },
   "wordsFinal": {
    "key": "open.ts.wordsFinal",
    "text": "Acum Ț stă la final. Ține-l până la capăt!",
    "voice": "open.ts.wordsFinal"
   },
   "clusters": {
    "key": "open.ts.clusters",
    "text": "Ț are vecini noi, alte consoane. Hai să-i cunoaștem!",
    "voice": "open.ts.clusters"
   },
   "pairs": {
    "key": "open.ts.pairs",
    "text": "Două cuvinte seamănă mult. Țuțu le încurcă. Ajuți?",
    "voice": "open.ts.pairs"
   },
   "sentences": {
    "key": "open.ts.sentences",
    "text": "Țuțu spune povești scurte. Spune-le și tu, cuvânt cu cuvânt.",
    "voice": "open.ts.sentences"
   },
   "twister": {
    "key": "open.ts.twister",
    "text": "O frământare! Întâi rar, ca melcul. Apoi puțin mai repede.",
    "voice": "open.ts.twister"
   },
   "retell": {
    "key": "open.ts.retell",
    "text": "Uite trei poze cu Țuțu. Ce s-a întâmplat?",
    "voice": "open.ts.retell"
   },
   "everyday": {
    "key": "open.ts.everyday",
    "text": "Azi Ț vine cu tine acasă. Ai o misiune!",
    "voice": "open.ts.everyday"
   }
  }
 },
