<?xml version="1.0" encoding="utf-8"?>
<!-- :platform:ml. onnxruntime-android 1.31.1 declares INTERNET, ACCESS_NETWORK_STATE and Microsoft's 1DS telemetry
     provider (it loads the runtime at every launch, reads android_id, the phone model, locale and time zone, and
     uploads events over HTTP). Fonia sends nothing anywhere (docs/REGULI.md): all three are removed here, so any app that
     depends on this module gets the removal through the manifest merger. The app keeps its own removals and the
     checkDebugOnnxRuntime build check as a second line (ml/README.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application>
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>
