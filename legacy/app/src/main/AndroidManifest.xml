<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone for every exercise, camera for the mouth mirror. INTERNET only for the install code
         (InstallCount in :legacy:features: one random UUID and "android", sent once a day after the first profile,
         unless an adult switches it off). Nothing else goes out and nothing is downloaded (the models ship in the APK):
         ACCESS_NETWORK_STATE, which libraries (ONNX Runtime, Media3) bring, stays removed, so the model fetchers find no
         network to use, and check<Variant>OnnxRuntime fails the build if it is back in the merged manifest. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- enableOnBackInvokedCallback: the back gesture shows the page under the one being closed and the page follows
         the finger, as the swipe from the edge does on iOS.
         configChanges: like the iOS app, the screen keeps its state when the theme, the font size or the window
         change; Compose redraws for the new configuration instead of the activity being rebuilt. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Fonia">
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|fontScale|density|locale|layoutDirection|keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- onnxruntime-android 1.31 starts Microsoft's 1DS telemetry from this provider at every launch: it loads the
             runtime, reads android_id, the phone model, locale and time zone, and uploads events over HTTP. A children's
             app sends nothing to third parties (docs/REGULI.md, 03 §2.3), so the provider is removed; without its Java
             client the runtime's telemetry has no way out ("Android telemetry is unavailable because the 1DS Java
             HttpClient was not initialized"), and ZipaModel.load also switches it off. checkDebugOnnxRuntime fails the
             build if the provider comes back. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>
