<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system's own splash shows only the sky, no icon; Fonia's start screen takes over from it. -->
    <style name="Theme.Fonia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/sky</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
