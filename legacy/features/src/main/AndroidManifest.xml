<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The file for the logoped (ProfileExport) is shared from the cache through this provider, the way ShareLink
         hands a Transferable to the share sheet on iOS. -->
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fonia_export_paths" />
        </provider>
    </application>
</manifest>
