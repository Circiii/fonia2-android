<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is the Paper token (bg, #F4F6FF); Compose draws everything else. -->
    <style name="Theme.Fonia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fonia_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
