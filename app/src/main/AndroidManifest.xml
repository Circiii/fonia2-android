<?xml version="1.0" encoding="utf-8"?>
<!-- Fonia 2. No INTERNET permission, ever (children: nothing leaves the device). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allowed set: RECORD_AUDIO, CAMERA, VIBRATE, POST_NOTIFICATIONS. The camera runs only in MIRROR (frames in RAM). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- Merged in by media3 (prompt playback) and :platform:whisper (its model download, never used here: the model is
         copied onto the phone by hand); Fonia never needs the network or a wake lock. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:name=".FoniaApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Fonia">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
